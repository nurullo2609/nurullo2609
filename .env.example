# Anthropic API kaliti (server tomonda ishlatiladi, hech qachon frontendga chiqmaydi).
# Netlify da: Site settings > Environment variables ga qo'shing.
# Lokal test uchun bu faylni ".env" deb nusxalab, kalitni qo'ying.
ANTHROPIC_API_KEY=sk-ant-...

# Ixtiyoriy: modelni almashtirish (standart: claude-sonnet-4-6).
# Yangi/arzonroq variant: claude-sonnet-5
# CLAUDE_MODEL=claude-sonnet-5
